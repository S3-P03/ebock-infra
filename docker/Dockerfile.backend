FROM gradle:9.3-jdk21 AS build

WORKDIR /app

COPY ebock-backend/gradle.properties ./
COPY ebock-backend/build.gradle ebock-backend/settings.gradle ./
COPY ebock-backend/gradle/ gradle/
COPY ebock-backend/gradlew ./

RUN chmod +x gradlew

COPY ebock-backend/src/ src/

RUN gradle build -x test --no-daemon

FROM eclipse-temurin:21-jre

WORKDIR /app

COPY --from=build /app/build/quarkus-app/lib/ /app/lib/
COPY --from=build /app/build/quarkus-app/*.jar /app/
COPY --from=build /app/build/quarkus-app/app/ /app/app/
COPY --from=build /app/build/quarkus-app/quarkus/ /app/quarkus/

EXPOSE 8080

CMD ["java", "-jar", "/app/quarkus-run.jar"]